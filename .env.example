# Database
DATABASE_URL=postgresql+asyncpg://novara:novara@localhost:5432/novara
SYNC_DATABASE_URL=postgresql+psycopg2://novara:novara@localhost:5432/novara

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Environment
NOVARA_ENV=development
LOG_LEVEL=INFO

# HTTP client settings
HTTP_TIMEOUT=30
HTTP_MAX_CONNECTIONS=20
HTTP_USER_AGENT="Novara/0.1 (+https://github.com/slothking1/novara007)"

# Cover storage (local path or S3 prefix)
COVER_STORAGE_PATH=/tmp/novara/covers

# Ingestion rate limiting (requests per second per source)
INGESTION_RATE_LIMIT=1.0
